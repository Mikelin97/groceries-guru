# Groceries Guru Environment Configuration
# Copy this to .env.local and update with your actual values

# Database Configuration
POSTGRES_URL=postgresql://postgres:postgres_secure_password@localhost:5432/groceries_guru
POSTGRES_PASSWORD=postgres_secure_password
REDIS_URL=redis://localhost:6379

# Application Settings
BASE_URL=http://localhost:3000
NODE_ENV=development
AUTH_SECRET=your_auth_secret_here

# AI Services
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Alibaba Cloud Bailian Configuration
# Get these from: RAM console and Bailian Model Studio
ALIBABA_CLOUD_ACCESS_KEY_ID=your_access_key_id_here
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your_access_key_secret_here
ALIBABA_CLOUD_REGION=cn-beijing
BAILIAN_ENDPOINT=bailian.cn-beijing.aliyuncs.com
BAILIAN_WORKSPACE_ID=your_workspace_id_here
BAILIAN_INDEX_ID=your_index_id_here

# Vector Search Settings
USE_CLOUD_VECTOR_DB=false  # Set to true to use Bailian, false for mock data

# Payment Integration (Optional)
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here